#!name=哔哩哔哩分享增强
#!desc=移除无用分享选项，修改链接分享信息。
#!author=Margele
#!category=Margele's Surge Modules

[Script]
bilibili-share-click-hooks = type=http-request,pattern=^https?:\/\/api\.bili(bili\.com|api\.net|api\.com)\/x\/share\/click$,script-path=https://raw.githubusercontent.com/Margele/surge-modules/refs/heads/main/bilibili-share-hook.js,requires-body=true
bilibili-share-channel-hooks = type=http-request,pattern=^https?:\/\/api\.bili(bili\.com|api\.net|api\.com)\/x\/share\/channels,script-path=https://raw.githubusercontent.com/Margele/surge-modules/refs/heads/main/bilibili-share-hook.js,requires-body=true

[MITM]
hostname = %APPEND% www.bilibili.com, search.bilibili.com, app.bilibili.com, app.biliapi.net, app.biliapi.com, api.bilibili.com, api.biliapi.net, api.biliapi.com, grpc.biliapi.net
h2 = true
